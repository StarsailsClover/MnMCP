# MnMCP - Essential Open Source Only
# Keep: core code, tests, main docs, CI/CD
# Remove: caches, dev resources, old versions

# Python cache (CRITICAL - never commit)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.pytest_cache/

# Build artifacts
build/
dist/
*.spec

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing coverage
.coverage
htmlcov/
.tox/

# Logs
*.log
logs/
log/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Development resources (not for open source)
09-MnMCP-DevResources/
03-MnMCP-Protocol-Bridge/

# Old versions
mnmcp-v2/
mnmcp-v1/

# Archive
archive/
backup_*/
*_backup/

